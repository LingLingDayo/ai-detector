{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ModelTrace AI Detector",
  "version": "1.0.0",
  "identifier": "com.modeltrace.ai-detector",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ModelTrace AI Detector",
        "label": "main",
        "width": 1020,
        "height": 840,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
