{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI-Detector",
  "version": "1.3.0",
  "identifier": "com.aidetector.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5400",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Detector",
        "label": "main",
        "width": 780,
        "height": 560,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBM0VCMDgwRDU5QjQxNzMKUldSelFadlZnTEErK2haSCtMdVNYU3VaQWZ5aUVRUVdCeEZvTGJoZTFwTEFjMDZSZnNsK3NvdTAK",
      "endpoints": [
        "https://github.com/LingLingDayo/ai-detector/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
