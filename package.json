{
  "name": "ai-detector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:app": "npm run tauri build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.js",
    "release:copy": "node scripts/copy-release.js",
    "release:tag": "node scripts/release-tag.js",
    "changelog:extract": "node scripts/extract-changelog.js",
    "test": "npx tsx --test \"src/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test:changelog": "node --test scripts/extract-changelog.test.js",
    "test:sync": "node --test scripts/sync-upstream.test.js",
    "test:reasoning": "node --experimental-strip-types --test src/data/modelReasoningRules.test.js",
    "test:fingerprint": "node --experimental-strip-types --test src/services/fingerprintSync.test.js",
    "test:retry": "node --experimental-strip-types --test src/utils/retry.test.js src/utils/timer.test.js",
    "test:probe": "node --test src/stores/probeTest.test.js",
    "test:pelican-prompt": "npx tsx --test src/stores/pelicanTest.test.js",
    "test:config": "npx tsx --test src/stores/config.test.js",
    "test:use-config": "npx tsx --test src/composables/useConfig.test.js",
    "sync": "node scripts/sync-upstream.js",
    "sync:check": "node scripts/sync-upstream.js --check"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vue-tsc": "^3.3.11"
  }
}
