{
  "name": "ai-detector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:app": "npm run tauri build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.js",
    "release:copy": "node scripts/copy-release.js",
    "release:tag": "node scripts/release-tag.js",
    "changelog:extract": "node scripts/extract-changelog.js",
    "test": "vitest run",
    "test:changelog": "vitest run scripts/extract-changelog.test.ts",
    "test:sync": "vitest run scripts/sync-upstream.test.ts",
    "test:reasoning": "vitest run src/data/modelReasoningRules.test.ts",
    "test:fingerprint": "vitest run src/services/fingerprintSync.test.ts",
    "test:retry": "vitest run src/utils/retry.test.ts src/utils/timer.test.ts",
    "test:probe": "vitest run src/stores/probeTest.test.ts",
    "test:pelican-prompt": "vitest run src/stores/pelicanTest.test.ts",
    "test:config": "vitest run src/stores/config.test.ts",
    "test:models": "vitest run src/stores/models.test.ts",
    "test:confirm": "vitest run src/stores/confirm.test.ts",
    "sync": "node scripts/sync-upstream.js",
    "sync:check": "node scripts/sync-upstream.js --check"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  }
}
